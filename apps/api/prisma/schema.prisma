generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  PROCESSING
  COMPLETED
  FAILED
  DELETION_PENDING
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleId  String   @unique
  email     String   @unique
  name      String
  picture   String?
  createdAt DateTime @default(now())

  documents Document[]

  @@map("users")
}

model Document {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  title        String         @db.VarChar(120)
  instruction  String         @db.VarChar(2000)
  analysis     String?        @db.Text
  status       DocumentStatus @default(PROCESSING)
  errorCode    String?
  errorMessage String?
  truncated    Boolean        @default(false)

  s3Key        String @unique
  originalName String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletionRequestedAt   DateTime?
  deletionNextAttemptAt DateTime?
  deletionLeaseUntil    DateTime?
  deletionAttempts      Int       @default(0)
  deletionError         String?   @db.Text

  analysisNextAttemptAt DateTime  @default(now())
  analysisLeaseUntil    DateTime?
  analysisAttempts      Int       @default(0)
  analysisError         String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status, deletionNextAttemptAt, deletionLeaseUntil])
  @@index([status, analysisNextAttemptAt, analysisLeaseUntil])
  @@map("documents")
}
