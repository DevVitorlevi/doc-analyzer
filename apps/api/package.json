{
  "name": "@doc-analyzer/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "prisma generate --schema=prisma/schema.prisma",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "node --env-file=../../.env.test ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "smoke:storage": "tsx --env-file=../../.env scripts/storage-smoke.ts",
    "smoke:openai": "tsx --env-file=../../.env scripts/openai-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "google-auth-library": "^11.3.4",
    "jose": "^6.2.17",
    "mammoth": "^1.13.0",
    "openai": "^7.58.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jszip": "^3.10.2",
    "prisma": "^6.19.3",
    "vitest": "^5.1.0"
  }
}
